{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main",
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mjs",
      "**/*.cjs",
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/reports",
      "!**/.react-router",
      "!**/.tmp",
      "!**/*.d.ts",
    ],
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "domains": { "project": "recommended" },
    "rules": {
      "preset": "recommended",
      // === Hardening Phase 1 — universal free ratchets (see ADR-035 §Rule
      // hardening). Every rule here is 0 findings today: they lock in conventions
      // the codebase already follows so no dev or agent can regress them. ===
      "suspicious": {
        "noVar": "error",
        "noUnusedExpressions": "error",
        "useErrorMessage": "error",
        // === Phase 2 (see ADR-035 §7) ===
        "noConsole": {
          "level": "error",
          // error/warn/info are legitimate operational signal; log/debug are the
          // strays. Scripts/CLIs/.mjs/.cjs are exempt entirely (override below).
          "options": { "allow": ["error", "warn", "info"] },
        },
        "noDeprecatedImports": "error", // importing an @deprecated export
        "noTsIgnore": "error", // prefer @ts-expect-error; agrees w/ tseslint (safety net)
        // === Phase 3 (net-new; no eslint/oxlint equivalent — see ADR-035 §7) ===
        "noShadow": "error", // an inner binding hiding an outer one is a bug magnet
        "noEmptyBlockStatements": "error", // empty {} block = incomplete refactor
      },
      "complexity": {
        "useArrayFind": "error", // filter(...)[0] -> find(...)
        "noImplicitCoercions": "error", // Phase 2: +x / !!x -> explicit conversion
      },
      "style": {
        // Sole enforcer of the repo array-type convention (typescript.md); no
        // Oxlint/ESLint rule covers it. "shorthand" keeps `T[]`/`readonly T[]`
        // and rewrites `Array<T>`/`ReadonlyArray<T>`.
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "shorthand" },
        },
        // Type imports go on their own `import type { … }` line, never inline
        // alongside values. The rule ships in `recommended`, but at its default
        // `warn` (which fails nothing) and default `style: "auto"`, which
        // EXPLICITLY permits `import { type T, V }` when values are imported
        // too — so the mixed form passed every gate by design, not oversight.
        // Both halves are needed: the level to make it block, the option to
        // make it disagree with the mixed form at all.
        "useImportType": {
          "level": "error",
          "options": { "style": "separatedType" },
        },
        "noInferrableTypes": "error", // redundant annotations — let TS infer (Rule 9)
        "noYodaExpression": "error",
        "useCollapsedElseIf": "error",
        "noUselessElse": "error",
        "noEnum": "error", // repo prefers `as const` unions over TS enums
        "noParameterProperties": "error", // explicit fields, not constructor params
        // === Phase 2 — new rule + agreeing safety-net duplicates (ADR-035 §7) ===
        "noParameterAssign": "error", // never reassign params (Rule 6)
        "useConsistentTypeDefinitions": {
          "level": "error",
          // `type` not `interface` (Rule 1); agrees with ESLint consistent-type-definitions.
          "options": { "style": "type" },
        },
        "noNamespace": "error", // agrees with tseslint no-namespace (safety net)
        "useThrowNewError": "error", // throw new Error(); agrees with unicorn (safety net)
        // === Phase 4 (ADR-035 §7) ===
        // Hard-ban `export default` in ordinary code — the repo is named-export
        // only (0 strays today). Framework/tooling files that MUST default-export
        // (RR routes, config, entry/root, eslint rules) are exempt in the override
        // below; keep that list in sync when a new such file class appears.
        "noDefaultExport": "error",
        // NOTE: useNumberNamespace is deliberately NOT enabled — it wants
        // `Number.POSITIVE_INFINITY`/`Number.NaN`, which directly CONFLICTS with
        // ESLint's `unicorn/prefer-global-number-constants` (wants the globals
        // `Infinity`/`NaN`, the repo's convention). The rule has no options to
        // reconcile, and its other coverage (parseInt/isNaN) is already owned by
        // ESLint + Biome's recommended `noGlobalIsNan`. See ADR-035 §7.
      },
      "performance": {
        "noDelete": "error", // aligns with immutability (Rule 6)
      },
      "correctness": {
        "noUndeclaredVariables": "error", // Phase 2: agrees with `no-undef` (safety net)
      },
    },
  },
  "overrides": [
    {
      // Workspaces that contain JSX. Every workspace is in exactly one of the
      // two rosters; `vp run lint:plugins:verify` enforces that.
      "includes": ["apps/showcase/**", "packages/ui/**"],
      "linter": {
        "domains": { "react": "recommended" },
        "rules": {
          "a11y": {
            // `Checkbox` renders a real `<input type="checkbox">`, so a <label>
            // wrapping one IS labelling a control — Biome just cannot see
            // through the component boundary. Naming it here keeps the rule ON
            // and still catching genuine unlabelled controls, rather than
            // silencing it. Add any future input-rendering component here.
            "noLabelWithoutControl": {
              "level": "error",
              "options": { "inputComponents": ["Checkbox"] },
            },
          },
          "correctness": {
            "noNestedComponentDefinitions": "error",
            "useExhaustiveDependencies": "off",
            "noReactPropAssignments": "error",
            "useUniqueElementIds": "error", // Phase 2: no static literal id on JSX elements
          },
          "suspicious": {
            "noDuplicatedSpreadProps": "error",
            "noLeakedRender": "error", // Phase 3: cond && <X/> must be a real boolean
            "noReactForwardRef": "error", // Phase 2: React 19 ref-as-prop; agrees w/ oxlint react-x
          },
          "style": {
            "useReactFunctionComponents": "error",
            "useComponentExportOnlyModules": "error",
            "useSelfClosingElements": "error", // <div></div> -> <div/>
            "useFragmentSyntax": "error", // <React.Fragment> -> <>
          },
          "nursery": {
            // Enforces StyleX-only (Rule 2): bans inline `style={{…}}`. NURSERY —
            // re-check on any Biome upgrade (see ADR-035 §Rule hardening).
            "noInlineStyles": "error",
          },
        },
      },
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "linter": {
        "domains": { "test": "recommended" },
        "rules": {
          "style": {
            // Fast Refresh only works when a file only exports components — and
            // Fast Refresh (HMR) never touches test files: they run under
            // Vitest, not the dev server, so this rule is categorically
            // inapplicable here. The inline `Wrapper`/`TestHarness` component
            // passed to renderHook/render's `wrapper` option is the idiomatic
            // RTL pattern and cannot be expressed without defining a component.
            // The rule stays ON and clean for every source file, where it
            // enforces the one-component bundle.
            "useComponentExportOnlyModules": "off",
          },
          "correctness": {
            // Test fixtures legitimately hard-code element ids so the test can
            // assert on them (id-forwarding tests; SSR-markup snapshots): the
            // production "two mounted instances collide" concern does not apply
            // to a single test render. Card.test asserts getAttribute('id'),
            // AppDocument.test asserts the literal `<div id="app-root">` markup.
            "useUniqueElementIds": "off",
          },
          "suspicious": {
            // An empty function IS the intent in tests: `mockImplementation(() => {})`
            // is the idiomatic vitest way to stub a call to a no-op (e.g. silencing
            // `console.warn`), and `onClick: () => {}` is a standard no-op fixture
            // handler. Every empty block flagged here is in a test file; none are
            // in source, where the rule stays ON to catch incomplete refactors.
            "noEmptyBlockStatements": "off",
            // Test shadows are the idiomatic `vi.hoisted(() => function MockX() {})`
            // mock pattern — the named function expression deliberately shares its
            // const's name for readable stack traces; renaming would only mismatch
            // the pair. Test-scope shadowing is low-stakes; the rule stays ON for
            // source (3 genuine shadows there were fixed, not silenced).
            "noShadow": "off",
          },
          "complexity": {
            "noExcessiveNestedTestSuites": "error", // cap describe() nesting depth
          },
          "nursery": {
            // NURSERY — re-check on any Biome upgrade (see ADR-035 §Rule hardening).
            "useTestHooksOnTop": "error", // before/after hooks grouped at top of block
            "useConsistentTestIt": "error", // Phase 2: consistent it()/test() (nursery)
            "noIdenticalTestTitle": "error", // Phase 2: no duplicate test titles (nursery)
          },
        },
      },
    },
    {
      // Workspaces that contain no JSX. That is the only axis this splits on:
      // `api` and `utils` are client-safe, so a browser-hostile rule needs its
      // own narrower block, not this one.
      "includes": [
        "packages/api/**",
        "packages/devkit/**",
        "packages/eslint-local-rules/**",
        "packages/node-runtime/**",
        "packages/repo-standards/**",
        "packages/server/**",
        "packages/ts-configs/**",
        "packages/tsconfig/**",
        "packages/utils/**",
        "packages/vite-configs/**",
      ],
      "linter": {
        "rules": {
          "style": {
            "useNodeAssertStrict": "error", // node:assert -> node:assert/strict
            // noProcessEnv is deliberately off: env is centralised through Zod
            // schemas, so every `process.env` read is the validation boundary.
            // They sit in ordinary util files, so there is no clean glob
            // exemption. See ADR-035 §7.
          },
        },
      },
    },
    {
      // Console output IS the product here — build/config scripts, CLIs, and
      // `.mjs`/`.cjs` tooling — not a stray debug left in shipped app code.
      // `logger.util.ts` is the one sanctioned console wrapper (it already
      // carries `eslint-disable no-console` per call). `noConsole` stays ON
      // everywhere else (allow-listing error/warn/info); in these it is off.
      "includes": [
        "**/*.mjs",
        "**/*.cjs",
        "**/scripts/**",
        "**/*.cli.ts",
        "**/logger.util.ts",
      ],
      "linter": {
        "rules": { "suspicious": { "noConsole": "off" } },
      },
    },
    {
      // Framework/tooling files whose default export is a contract, exempt from
      // noDefaultExport: React Router route modules + the `routes.ts` route config;
      // Vite/tool configs; the SSR `entry.*`/`root.tsx`; and eslint rule files
      // (a default export IS the ESLint rule API). Every other file must use named
      // exports (0 strays today). Keep this list current as new such files appear.
      "includes": [
        "**/routes/**",
        "**/routes.ts",
        "**/*.config.ts",
        "**/*.config.mjs",
        "**/*.config.cjs",
        "**/config/**",
        "**/entry.*.tsx",
        "**/root.tsx",
        // Only the rule sources, not the whole package: @lcabrera/eslint-plugin is
        // public, so its exemptions are held to the narrowest glob that works.
        "**/eslint-local-rules/src/**",
      ],
      "linter": {
        "rules": { "style": { "noDefaultExport": "off" } },
      },
    },
    {
      // WAI-ARIA APG Tabs pattern: a tabpanel carries tabindex="0" so keyboard
      // users can reach panel content that holds no focusable element of its
      // own. This is the spec's own recommendation and what Radix/Reach ship;
      // removing it would strand keyboard users in the panel. eslint's
      // jsx-a11y equivalent recognises this via `roles: ['tabpanel']` in its
      // recommended config — Biome's port has no options at all, so the file
      // is the only available scope.
      "includes": ["**/TabsContent.component.tsx"],
      "linter": {
        "rules": { "a11y": { "noNoninteractiveTabindex": "off" } },
      },
    },
    {
      // ARIA window-splitter pattern: a FOCUSABLE separator carrying
      // aria-valuenow/min/max, which is a widget role, not the structural
      // separator `<hr>` Biome suggests. `<hr>` cannot take focus or express a
      // value, so the suggested rewrite would delete the whole interaction.
      // The rule only maps role→element and does not model the focusable case.
      "includes": ["**/ResizeHandle.component.tsx"],
      "linter": {
        "rules": { "a11y": { "useSemanticElements": "off" } },
      },
    },
    {
      // The trigger DOES set `role='button'` — but conditionally, under exactly
      // the same `shouldUseInteractiveTrigger` condition that adds its keyboard
      // handler and tabIndex. Biome cannot correlate the two ternaries: probing
      // shows an identical span passes with an unconditional role and fails with
      // a conditional one. The conditional is the point — when the child is
      // already a native button, a second role='button' would nest one inside
      // the other. Do not "fix" this by extracting the host element either; that
      // breaks getIsNativeInteractiveElement and regresses to nested role=button.
      "includes": ["**/TooltipTrigger.component.tsx"],
      "linter": {
        "rules": { "a11y": { "noStaticElementInteractions": "off" } },
      },
    },
    {
      // Biome models `<tr>` as role=row and treats a row as focusable, because
      // a row IS focusable inside a role=grid — which this Table now is
      // (ADR-062). The spacer is still not: it declares no role, carries no
      // tabIndex and renders one empty colSpan'd cell with no focusable
      // descendant, so the filler that makes the scroll height work is
      // correctly hidden. There is no code fix — `aria-hidden` trips this rule,
      // `role=presentation` trips noInteractiveElementToNoninteractiveRole, and
      // dropping the attribute (Biome's own suggested fix) would announce a
      // blank spacer row to screen readers.
      "includes": ["**/SpacerRow.component.tsx"],
      "linter": {
        "rules": { "a11y": { "noAriaHiddenOnFocusable": "off" } },
      },
    },
    {
      // `<table role="grid">` and `<td role="gridcell">` are the markup the
      // WAI-ARIA APG uses for an interactive data grid, and ARIA's taxonomy
      // makes `grid` a subclass of `table` — so this is the spec's own
      // refinement of a table, not the "non-interactive element handed an
      // interactive role" the rule guards against.
      // The two elements differ in WHY they need the attribute, and only one is
      // a sole source: `TableBase.stylex.ts` keeps `display: table`, so the
      // `<table>` retains its implicit `table` role and `role="grid"` upgrades
      // it; `TableBodyCell.stylex.ts` sets every cell to `display: flex`, which
      // DOES remove the implicit `cell` role, leaving the attribute as the only
      // source (ADR-062).
      // Biome's rule takes no options — its schema is
      // `additionalProperties: false` — so it cannot be told about the
      // `table: ['grid']` / `td: ['gridcell']` allowances jsx-a11y ships by
      // default on the same rule. A fix does exist and is rejected on merit,
      // not for lack of one: rendering `<div>`s instead, Biome's first
      // suggestion, discards the native table fallback for anything that does
      // not read ARIA, and simply dropping the roles re-exposes the grid as
      // generic containers.
      "includes": [
        "**/TableBase.component.tsx",
        "**/TableBodyCell.component.tsx",
      ],
      "linter": {
        "rules": {
          "a11y": { "noNoninteractiveElementToInteractiveRole": "off" },
        },
      },
    },
    {
      // The mirror complaint: Biome reads `<tbody>` as implicitly `rowgroup`,
      // `<tr>` as `row` and `<th scope="col">` as `columnheader`, and calls the
      // explicit roles redundant. They are not — and each of the three loses
      // its implicit role to its OWN stylesheet, which is what makes them
      // independent of one another:
      //   `<tbody>` — `TableBody.stylex.ts` `body()` sets `display: grid`
      //   `<tr>`    — `TableRow.stylex.ts` `base` sets `display: flex`
      //   `<th>`    — `TableHeaderCell.stylex.ts` `base()` sets `display: flex`
      // A browser drops an element's implicit table role along with its table
      // `display` (ADR-062). Reverting any one of those files therefore
      // discharges only its own role; the header cell in particular stays flex
      // whatever the row does.
      // The rule reads JSX, and the fact that makes these attributes
      // load-bearing lives in a `.stylex.ts` file it does not read — which is
      // also why no test written as a role QUERY can catch their deletion, since
      // jsdom resolves the very implicit roles these overrides destroy. Deleting
      // them breaks the rowgroup/row/cell ownership `role="grid"` requires.
      // The empty-state `<tbody>` keeps `display: table-row-group` and declares
      // no role: where the implicit one survives, none is added.
      "includes": [
        "**/TableBody.component.tsx",
        "**/TableHeaderCell.component.tsx",
        "**/TableRow.component.tsx",
      ],
      "linter": {
        "rules": { "a11y": { "noRedundantRoles": "off" } },
      },
    },
    {
      // JSON Schema conditionals, not thenables: `if`/`then` are reserved
      // keywords of the schema DSL, so these objects are data describing a
      // schema and are never awaited. Renaming the key would break validation.
      // The same finding was already adjudicated for Oxlint in this file —
      // see the `oxlint-disable-next-line unicorn/no-thenable` comments.
      "includes": ["**/enterpriseOrders.schema.ts"],
      "linter": {
        "rules": { "suspicious": { "noThenProperty": "off" } },
      },
    },
  ],
}

# Root-level environment for tooling scripts. Copy to `.env` (gitignored) and fill
# in. NEVER commit `.env` or real tokens — only this example file is tracked.

# --- SonarCloud reporting (scripts/sonar-report.mjs / `vp run sonar:report`) ---
# A read-only SonarCloud USER token (SonarCloud → My Account → Security →
# Generate Tokens → "User Token"). Needs only browse permission on the project.
# In CI, provide this as a GitHub Actions secret instead of a file.
SONAR_TOKEN=

# Optional overrides — the script defaults to this repo's SonarCloud project.
# SONAR_PROJECT_KEY=luciocabrera_vite-react-compiler
# SONAR_BASE_URL=https://sonarcloud.io
# SONAR_MAIN_BRANCH=main

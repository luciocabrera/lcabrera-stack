{
  "name": "@repo/scan-orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "node --env-file-if-exists=../../docker/local/.env --env-file-if-exists=.env --experimental-strip-types --watch src/server.ts",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp run --filter eslint-local-rules-shared build && vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp run --filter eslint-local-rules-shared build && vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "start": "node --env-file-if-exists=../../docker/local/.env --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@lcabrera/server": "workspace:*",
    "@repo/agent-runner": "workspace:*",
    "@repo/node-runtime": "workspace:*",
    "@repo/scan-ingestion": "workspace:*",
    "pg": "catalog:backend",
    "ws": "catalog:backend",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@repo/vite-configs": "workspace:*",
    "@types/node": "catalog:types",
    "@types/pg": "catalog:types",
    "@types/ws": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

# Copy to .env (gitignored). The dev/start scripts load
# ../../docker/local/.env FIRST (shared DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/
# DB_NAME), then this file — only orchestrator-local values belong here.

# REQUIRED — Agent SDK credential for agentic scanners (code-smell-checker,
# code-smell-zen, ...). Deterministic scanners (eslint/oxlint/fallow) run
# without it, but the process refuses to boot when it is missing entirely.
ANTHROPIC_API_KEY=sk-ant-...

# Org-wide rolling-24h LLM spend cap in USD. Agentic scans are skipped (marked
# failed, $0 usage row logged) once the trailing-24h total reaches this.
# Default: 50
#LLM_DAILY_COST_CAP_USD=50

# Port for the /ws/runs live-status WebSocket server. Default: 4100
#SCAN_ORCHESTRATOR_PORT=4100

# Global concurrency cap (PRD_V2 §9 / ADR-033): the most scans this orchestrator
# executes on the host at once. §8's per-project lock already caps each project
# at one run; this caps the platform total so N projects can't start N host
# executions simultaneously. Scans beyond the cap wait for a slot (never
# rejected). Raise it as host capacity allows. Default: 3
#MAX_CONCURRENT_SCANS=3

{
  "name": "admin-system",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp run --filter eslint-local-rules-shared build && vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp run --filter eslint-local-rules-shared build && vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "dev": "sh -c 'set -a; eval \"$(tr -d \"\\r\" < ../../docker/local/.env)\"; eval \"$(tr -d \"\\r\" < ./.env 2>/dev/null)\"; set +a; exec react-router dev'",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@lcabrera/ui": "workspace:*",
    "@lcabrera/utils": "workspace:*",
    "@react-router/serve": "catalog:",
    "@repo/scan-ingestion": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "fflate": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@react-router/dev": "catalog:",
    "@repo/vite-configs": "workspace:*",
    "@stylexjs/eslint-plugin": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-local-rules": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-react-dom": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-react-x": "catalog:",
    "eslint-plugin-security": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-babel": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}

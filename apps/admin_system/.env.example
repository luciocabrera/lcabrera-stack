# Copy to .env (gitignored). The dev/start scripts load
# ../../docker/local/.env FIRST (shared DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/
# DB_NAME), then this file — only admin-app-local values belong here.

# Signs the auth session cookie (ADR-017). Defaults to a dev-only insecure
# value; set a real random secret for anything beyond local use. Changing it
# invalidates every active session.
#SESSION_SECRET=change-me-to-a-long-random-string

# Where uploaded project snapshots are unpacked (ADR-028). Defaults to
# <os tmpdir>/cqms-snapshots, which the OS may wipe on reboot while
# projects.latest_snapshot_id still points at the deleted directory — set an
# absolute persistent path if you want snapshots to survive restarts.
#CQMS_SNAPSHOTS_DIR=/var/lib/cqms/snapshots

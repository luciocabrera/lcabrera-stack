# Showcase app environment. Copy to `.env` in this directory (gitignored) and
# fill in. Only this example file is tracked — never commit the real one.

# --- Auth (apps/showcase/src/auth/env.schema.ts) ---
# Both variables have development defaults that are PUBLISHED IN THIS REPOSITORY,
# so they apply only when NODE_ENV is `development` or `test`. Any other value —
# including NODE_ENV being unset — is refused, and the parse fails naming the
# variable rather than signing session tokens with a string anyone can read.
#
# THIS IS WHY `vp run start:showcase` NEEDS THEM. `@react-router/serve` sets
# `NODE_ENV = NODE_ENV ?? "production"`, so serving the built app locally takes
# the refusing branch and the first auth-touching request fails until both are
# set here. `vp run dev:showcase` does not: the dev server runs as
# `development`, where the defaults apply and neither line is needed.
#
# LEAVE THEM COMMENTED OUT RATHER THAN ASSIGNING AN EMPTY STRING. Missing and
# blank are not the same thing here, and in this file's own mode they behave
# oppositely: a missing value takes the published default, which is what
# development mode is for, while a blank one is refused. So an empty assignment
# is the single shape that stops the app instead of starting it. The refusal
# names the variable and says to remove the line.

# Signs and verifies the session token. Any long random string; rotate it and
# every existing session is invalidated.
# AUTH_TOKEN_SECRET=

# scrypt hash of the demo account's password, as `salt:hash`. Generate one with
# `hashSecret({ secret })` from `@lcabrera/server/crypto/hash-secret.util`.
# Deploying with the repository's own value means anyone who has read this
# repository can log in.
# AUTH_DEMO_PASSWORD_HASH=

# The demo account's address. Not a credential, so it keeps its default
# (`demo@example.com`) in every mode; set it only to change the login shown.
# AUTH_DEMO_EMAIL=

{
  "name": "car-sales-api-fast",
  "version": "1.0.0",
  "description": "Simple API server for car sales data (Fastify)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"vp run build && node --env-file-if-exists=.env dist/server.js\"",
    "seed": "node --env-file-if-exists=.env scripts/seed-db.js",
    "start": "vp run build && node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.8.4",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "nodemon": "^3.1.14",
    "typescript": "catalog:"
  }
}

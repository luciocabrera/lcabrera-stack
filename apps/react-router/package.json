{
  "name": "vite-react-compiler",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:eslint-rules": "cd ../../packages/eslint-local-rules && vp run build",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:lighthouse:check": "node scripts/check-lighthouse-scores.mjs",
    "dev": "react-router dev",
    "lint": "vp run build:eslint-rules && vp lint . --fix",
    "lint:check": "vp run build:eslint-rules && vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc --noEmit",
    "preview": "vp preview",
    "knip": "knip",
    "fallow": "npx fallow dead-code",
    "fallow:full": "npx fallow",
    "test:watch": "node node_modules/vitest/vitest.mjs"
  },
  "dependencies": {
    "@react-router/node": "catalog:",
    "@react-router/serve": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "isbot": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@babel/preset-typescript": "catalog:",
    "@eslint/js": "catalog:",
    "@react-router/dev": "catalog:",
    "@repo/vite-configs": "workspace:*",
    "@stylexjs/eslint-plugin": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-local-rules": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-react-dom": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-react-x": "catalog:",
    "eslint-plugin-security": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "knip": "catalog:",
    "lighthouse": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin": "catalog:",
    "vite": "catalog:",
    "vite-plugin-babel": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}

{
  "name": "car-sales-api",
  "version": "1.0.0",
  "description": "Simple API server for car sales data",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"vp run build && node --env-file-if-exists=.env dist/server.js\"",
    "seed": "node --env-file-if-exists=.env scripts/seed-db.js",
    "start": "vp run build && node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "nodemon": "^3.1.14",
    "typescript": "catalog:"
  }
}

{
  "name": "car-sales-api",
  "version": "1.0.0",
  "private": true,
  "description": "Simple API server for car sales data",
  "main": "dist/server.js",
  "scripts": {
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "dev": "nodemon --watch src --ext ts --exec \"vp run build && node --env-file-if-exists=../../docker/local/.env --env-file-if-exists=.env dist/server.js\"",
    "seed": "node --env-file-if-exists=../../docker/local/.env --env-file-if-exists=.env ../../scripts/seed-db.cjs",
    "db:seed": "vp run -w db:up && vp run seed",
    "start": "vp run build && node --env-file-if-exists=../../docker/local/.env --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lcabrera/server": "workspace:*",
    "@repo/node-runtime": "workspace:*",
    "api-shared": "workspace:*",
    "cors": "catalog:backend",
    "express": "catalog:backend",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@repo/vite-configs": "workspace:*",
    "@types/cors": "catalog:types",
    "@types/express": "catalog:types",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "nodemon": "catalog:backend",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

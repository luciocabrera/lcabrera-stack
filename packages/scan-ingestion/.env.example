# Canonical shared Postgres host/port/user live in ../../docker/local/.env,
# loaded first via --env-file-if-exists in the "migrate" script.
DB_NAME=cqms_db
# DB_PASSWORD=<copy the real POSTGRES_PASSWORD from ../../docker/local/.env —
# that file's own DB_PASSWORD key is a stale placeholder, not the real value>

# CodePulse CLI push (`vp run push --project-id=<uuid>`, ADR-029): the target
# server origin and the Bearer token issued from the /cqms/account/tokens page.
# CODEPULSE_URL=http://localhost:5173
# CODEPULSE_TOKEN=cqms_<tokenId>.<secret>

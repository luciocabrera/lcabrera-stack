{
  "name": "@repo/scan-ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./ingestion/ingestion.constants": "./src/ingestion/ingestion.constants.ts",
    "./ingestion/ingestion.types": "./src/ingestion/ingestion.types.ts",
    "./ingestion/ingestReport": "./src/ingestion/ingestReport.ts",
    "./ingestion/snapshots/collectRunSnapshotFiles": "./src/ingestion/snapshots/collectRunSnapshotFiles.ts",
    "./ingestion/snapshots/saveProjectSnapshot": "./src/ingestion/snapshots/saveProjectSnapshot.ts",
    "./ingestion/workspaces/discoverProjectWorkspaces.util": "./src/ingestion/workspaces/discoverProjectWorkspaces.util.ts",
    "./queries/*.util": "./src/queries/*.util.ts",
    "./registry/writeScannerArtifacts.util": "./src/registry/writeScannerArtifacts.util.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "migrate": "node --env-file-if-exists=../../docker/local/.env --env-file-if-exists=.env --experimental-strip-types ./src/db/runMigrations.ts",
    "push": "node --env-file-if-exists=.env --experimental-strip-types ./src/cli/push.cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@lcabrera/scan-report": "workspace:*",
    "@lcabrera/server": "workspace:*",
    "@lcabrera/utils": "workspace:*",
    "fflate": "catalog:runtime",
    "pg": "catalog:backend",
    "zod": "catalog:runtime"
  },
  "devDependencies": {
    "@repo/vite-configs": "workspace:*",
    "@types/node": "catalog:types",
    "@types/pg": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

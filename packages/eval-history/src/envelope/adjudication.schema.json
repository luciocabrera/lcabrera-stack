{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case": {
      "type": "object",
      "properties": {
        "analyzer": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "case_id": {
          "type": "string",
          "pattern": "^FP-\\d{4,}$"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pr": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "analyzer",
        "base_sha",
        "case_id",
        "content_hash",
        "created_at",
        "file",
        "finding_id",
        "head_sha",
        "pr",
        "rule"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": ["dismissed", "fixed", "split", "escalated"]
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "verifiers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agent_prompt_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cost_usd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "evidence": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["judge", "adversary"]
          },
          "tokens_in": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tokens_out": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "verdict": {
            "type": "string",
            "enum": ["REAL", "FALSE_POSITIVE"]
          }
        },
        "required": [
          "agent_prompt_hash",
          "cost_usd",
          "duration_ms",
          "evidence",
          "model",
          "role",
          "tokens_in",
          "tokens_out",
          "verdict"
        ]
      }
    }
  },
  "required": ["case", "outcome", "schema_version", "verifiers"]
}

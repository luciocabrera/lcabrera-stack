{
  "name": "@repo/repo-standards",
  "version": "0.0.0",
  "private": true,
  "description": "The gates that keep a repository's commits, branches, pull requests and issues to one enforced shape — as commands, so any repository can run them.",
  "bin": {
    "repo-verify-branch": "./scripts/verify-branch-name.mjs",
    "repo-verify-commit": "./scripts/verify-commit-msg.mjs",
    "repo-verify-issue": "./scripts/verify-issue-body.mjs",
    "repo-verify-pr": "./scripts/verify-pr.mjs"
  },
  "type": "module",
  "exports": {
    "./cli-input": "./scripts/cli-input.mjs",
    "./commit-convention": "./scripts/commit-convention.mjs",
    "./config": "./scripts/config.mjs",
    "./coordination-parse": "./scripts/coordination-parse.mjs",
    "./coordination-read": "./scripts/coordination-read.mjs",
    "./git-dir": "./scripts/git-dir.mjs",
    "./host-root": "./scripts/host-root.mjs",
    "./package.json": "./package.json",
    "./report-warnings": "./scripts/report-warnings.mjs",
    "./safe-read": "./scripts/safe-read.mjs",
    "./workspace-scopes": "./scripts/workspace-scopes.mjs"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "devDependencies": {
    "@lcabrera/vite-config": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

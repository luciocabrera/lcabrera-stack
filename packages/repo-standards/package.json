{
  "name": "@lcabrera/repo-standards",
  "version": "0.2.0",
  "private": false,
  "description": "The gates that keep a repository's commits, branches, pull requests, issues, coordination register, architecture decisions and published packages to one enforced shape — as commands, so any repository can run them.",
  "keywords": [
    "adr",
    "commit-convention",
    "conventional-commits",
    "git-hooks",
    "monorepo",
    "pull-request"
  ],
  "homepage": "https://github.com/luciocabrera/vite-react-compiler/tree/main/packages/repo-standards#readme",
  "bugs": "https://github.com/luciocabrera/vite-react-compiler/issues",
  "license": "MIT",
  "author": "Lucio Cabrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciocabrera/vite-react-compiler.git",
    "directory": "packages/repo-standards"
  },
  "bin": {
    "repo-adr": "./scripts/new-adr.mjs",
    "repo-audit-release": "./scripts/audit-release.mjs",
    "repo-claim-board": "./scripts/coordination-board-live.mjs",
    "repo-close-claim": "./scripts/close-coordination-claim.mjs",
    "repo-plan-release": "./scripts/release-publish-plan.mjs",
    "repo-verify-adrs": "./scripts/verify-adrs.mjs",
    "repo-verify-api-surface": "./scripts/verify-api-surface.mjs",
    "repo-verify-branch": "./scripts/verify-branch-name.mjs",
    "repo-verify-claims": "./scripts/verify-coordination.mjs",
    "repo-verify-commit": "./scripts/verify-commit-msg.mjs",
    "repo-verify-docs-paths": "./scripts/verify-docs-paths.mjs",
    "repo-verify-issue": "./scripts/verify-issue-body.mjs",
    "repo-verify-pr": "./scripts/verify-pr.mjs",
    "repo-verify-publish": "./scripts/verify-publish-surface.mjs",
    "repo-verify-script-size": "./scripts/verify-script-size.mjs",
    "repo-verify-stray-configs": "./scripts/verify-stray-configs.mjs",
    "repo-verify-types": "./scripts/verify-attw.mjs"
  },
  "files": [
    "scripts",
    "CHANGELOG.md",
    "!scripts/**/*.test.mjs"
  ],
  "type": "module",
  "exports": {
    "./adr-registry": "./scripts/adr-registry.mjs",
    "./adr-scaffold": "./scripts/adr-scaffold.mjs",
    "./cli-input": "./scripts/cli-input.mjs",
    "./commit-convention": "./scripts/commit-convention.mjs",
    "./config": "./scripts/config.mjs",
    "./coordination-board": "./scripts/coordination-board.mjs",
    "./coordination-close": "./scripts/coordination-close.mjs",
    "./coordination-overlap": "./scripts/coordination-overlap.mjs",
    "./coordination-parse": "./scripts/coordination-parse.mjs",
    "./coordination-read": "./scripts/coordination-read.mjs",
    "./coordination-reconcile": "./scripts/coordination-reconcile.mjs",
    "./coordination-remote": "./scripts/coordination-remote.mjs",
    "./coordination-schema": "./scripts/coordination-schema.mjs",
    "./error-message": "./scripts/error-message.mjs",
    "./git-dir": "./scripts/git-dir.mjs",
    "./host-root": "./scripts/host-root.mjs",
    "./package.json": "./package.json",
    "./publish-surface": "./scripts/publish-surface.mjs",
    "./publishable-workspaces": "./scripts/publishable-workspaces.mjs",
    "./registry-packument": "./scripts/registry-packument.mjs",
    "./release-publishable": "./scripts/release-publishable.mjs",
    "./report-warnings": "./scripts/report-warnings.mjs",
    "./safe-read": "./scripts/safe-read.mjs",
    "./workspace-scopes": "./scripts/workspace-scopes.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@arethetypeswrong/core": "catalog:tooling",
    "ts-morph": "catalog:tooling"
  },
  "devDependencies": {
    "@lcabrera/vite-config": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

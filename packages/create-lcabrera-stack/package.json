{
  "name": "create-lcabrera-stack",
  "version": "0.1.0",
  "private": false,
  "description": "Runs `devkit create`, so a new repository on this toolchain starts from `pnpm create lcabrera-stack` without knowing the toolchain's name first.",
  "keywords": [
    "create",
    "developer-tooling",
    "initializer",
    "scaffolding"
  ],
  "homepage": "https://github.com/luciocabrera/lcabrera-stack/tree/main/packages/create-lcabrera-stack#readme",
  "bugs": "https://github.com/luciocabrera/lcabrera-stack/issues",
  "license": "MIT",
  "author": "Lucio Cabrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciocabrera/lcabrera-stack.git",
    "directory": "packages/create-lcabrera-stack"
  },
  "bin": {
    "create-lcabrera-stack": "./scripts/create-lcabrera-stack.mjs"
  },
  "files": [
    "scripts",
    "CHANGELOG.md",
    "!scripts/**/*.test.mjs",
    "!scripts/**/*.md"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@lcabrera/devkit": "workspace:*"
  },
  "devDependencies": {
    "@lcabrera/vite-config": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

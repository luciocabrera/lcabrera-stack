# The template for `.env` beside it, which git ignores. Copy it there and
# replace each placeholder; nothing in this file is a working credential.
# The compose file reads the `DB_*` values to start the server, and the
# application's seed and server code read the same ones to connect to it.

COMPOSE_PROJECT_NAME=replace-with-this-repository-name

DB_HOST=localhost
DB_PORT=5432
DB_USER=replace_with_a_user_name
DB_PASSWORD=replace-with-a-password
DB_NAME=replace_with_a_database_name

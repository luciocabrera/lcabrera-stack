{
  "name": "@repo/devkit",
  "version": "0.0.0",
  "private": true,
  "description": "Materialises this repository's agent setup — skills, path rules, subagent definitions and the contracts they bind to — into a consumer repository, and reports what has diverged.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciocabrera/vite-react-compiler.git",
    "directory": "packages/devkit"
  },
  "bin": {
    "devkit": "./scripts/devkit.mjs"
  },
  "files": [
    "assets",
    "scripts",
    "CHANGELOG.md",
    "!scripts/**/*.test.mjs"
  ],
  "type": "module",
  "exports": {
    "./closure": "./scripts/closure.mjs",
    "./config": "./scripts/config.mjs",
    "./manifest": "./scripts/manifest.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "semver": "catalog:tooling"
  },
  "devDependencies": {
    "@lcabrera/vite-config": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@repo/repo-standards": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@repo/repo-standards": {
      "optional": true
    }
  }
}

{
  "name": "@lcabrera/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./config/config.constants": "./src/config/config.constants.ts",
    "./config/config.types": "./src/config/config.types.ts",
    "./config/get-api-base-url.util": "./src/config/get-api-base-url.util.ts",
    "./distinct/distinct.types": "./src/distinct/distinct.types.ts",
    "./distinct/fetch-distinct-values.util": "./src/distinct/fetch-distinct-values.util.ts",
    "./distinct/is-distinct-values-response.util": "./src/distinct/is-distinct-values-response.util.ts",
    "./distinct/parse-filter-options-params.util": "./src/distinct/parse-filter-options-params.util.ts",
    "./http/build-paginated-query-params.util": "./src/http/build-paginated-query-params.util.ts",
    "./http/fetch-and-validate.util": "./src/http/fetch-and-validate.util.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp run --filter eslint-local-rules-shared build && vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp run --filter eslint-local-rules-shared build && vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@lcabrera/utils": "workspace:*"
  },
  "devDependencies": {
    "@repo/vite-configs": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}

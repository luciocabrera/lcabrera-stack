{
  "name": "@lcabrera/api",
  "version": "0.4.1",
  "private": false,
  "description": "Browser-safe HTTP building blocks: API base-URL resolution, validated fetch, and paginated distinct-value queries.",
  "keywords": [
    "api-client",
    "browser",
    "fetch",
    "http",
    "typescript"
  ],
  "homepage": "https://github.com/luciocabrera/lcabrera-stack/tree/main/packages/api#readme",
  "bugs": "https://github.com/luciocabrera/lcabrera-stack/issues",
  "license": "MIT",
  "author": "Lucio Cabrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciocabrera/lcabrera-stack.git",
    "directory": "packages/api"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.*",
    "!src/**/*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./config/config.constants": "./src/config/config.constants.ts",
    "./config/config.types": "./src/config/config.types.ts",
    "./config/get-api-base-url.util": "./src/config/get-api-base-url.util.ts",
    "./distinct/distinct.types": "./src/distinct/distinct.types.ts",
    "./distinct/fetch-distinct-values.util": "./src/distinct/fetch-distinct-values.util.ts",
    "./distinct/is-distinct-values-response.util": "./src/distinct/is-distinct-values-response.util.ts",
    "./distinct/parse-filter-options-params.util": "./src/distinct/parse-filter-options-params.util.ts",
    "./http/build-paginated-query-params.util": "./src/http/build-paginated-query-params.util.ts",
    "./http/create-paginated-fetcher.util": "./src/http/create-paginated-fetcher.util.ts",
    "./http/http.types": "./src/http/http.types.ts",
    "./http/fetch-and-validate.util": "./src/http/fetch-and-validate.util.ts",
    "./olap/encode-drill-group.util": "./src/olap/encode-drill-group.util.ts",
    "./olap/is-olap-group-period.util": "./src/olap/is-olap-group-period.util.ts",
    "./olap/olap.constants": "./src/olap/olap.constants.ts",
    "./olap/olap.types": "./src/olap/olap.types.ts",
    "./olap/parse-drill-group.util": "./src/olap/parse-drill-group.util.ts"
  },
  "publishConfig": {
    "exports": {
      "./config/config.constants": {
        "types": "./dist/config/config.constants.d.mts",
        "default": "./dist/config/config.constants.mjs"
      },
      "./config/config.types": {
        "types": "./dist/config/config.types.d.mts",
        "default": "./dist/config/config.types.mjs"
      },
      "./config/get-api-base-url.util": {
        "types": "./dist/config/get-api-base-url.util.d.mts",
        "default": "./dist/config/get-api-base-url.util.mjs"
      },
      "./distinct/distinct.types": {
        "types": "./dist/distinct/distinct.types.d.mts",
        "default": "./dist/distinct/distinct.types.mjs"
      },
      "./distinct/fetch-distinct-values.util": {
        "types": "./dist/distinct/fetch-distinct-values.util.d.mts",
        "default": "./dist/distinct/fetch-distinct-values.util.mjs"
      },
      "./distinct/is-distinct-values-response.util": {
        "types": "./dist/distinct/is-distinct-values-response.util.d.mts",
        "default": "./dist/distinct/is-distinct-values-response.util.mjs"
      },
      "./distinct/parse-filter-options-params.util": {
        "types": "./dist/distinct/parse-filter-options-params.util.d.mts",
        "default": "./dist/distinct/parse-filter-options-params.util.mjs"
      },
      "./http/build-paginated-query-params.util": {
        "types": "./dist/http/build-paginated-query-params.util.d.mts",
        "default": "./dist/http/build-paginated-query-params.util.mjs"
      },
      "./http/create-paginated-fetcher.util": {
        "types": "./dist/http/create-paginated-fetcher.util.d.mts",
        "default": "./dist/http/create-paginated-fetcher.util.mjs"
      },
      "./http/http.types": {
        "types": "./dist/http/http.types.d.mts",
        "default": "./dist/http/http.types.mjs"
      },
      "./http/fetch-and-validate.util": {
        "types": "./dist/http/fetch-and-validate.util.d.mts",
        "default": "./dist/http/fetch-and-validate.util.mjs"
      },
      "./olap/encode-drill-group.util": {
        "types": "./dist/olap/encode-drill-group.util.d.mts",
        "default": "./dist/olap/encode-drill-group.util.mjs"
      },
      "./olap/is-olap-group-period.util": {
        "types": "./dist/olap/is-olap-group-period.util.d.mts",
        "default": "./dist/olap/is-olap-group-period.util.mjs"
      },
      "./olap/olap.constants": {
        "types": "./dist/olap/olap.constants.d.mts",
        "default": "./dist/olap/olap.constants.mjs"
      },
      "./olap/olap.types": {
        "types": "./dist/olap/olap.types.d.mts",
        "default": "./dist/olap/olap.types.mjs"
      },
      "./olap/parse-drill-group.util": {
        "types": "./dist/olap/parse-drill-group.util.d.mts",
        "default": "./dist/olap/parse-drill-group.util.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@lcabrera/utils": "workspace:*"
  },
  "devDependencies": {
    "@lcabrera/vite-config": "workspace:*",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

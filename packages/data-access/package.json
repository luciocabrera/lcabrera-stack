{
  "name": "@repo/data-access",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./api": "./src/api/index.ts",
    "./crypto/hashSecret.util": "./src/crypto/hashSecret.util.ts",
    "./crypto/isSecretHashValid.util": "./src/crypto/isSecretHashValid.util.ts",
    "./db/env.schema": "./src/db/env.schema.ts",
    "./db/getPool.util": "./src/db/getPool.util.ts",
    "./db/queryBuilder/QueryBuilder.types": "./src/db/queryBuilder/QueryBuilder.types.ts",
    "./db/queryBuilder/buildCountQuery.util": "./src/db/queryBuilder/buildCountQuery.util.ts",
    "./db/queryBuilder/buildDistinctQuery.util": "./src/db/queryBuilder/buildDistinctQuery.util.ts",
    "./db/queryBuilder/buildSelectQuery.util": "./src/db/queryBuilder/buildSelectQuery.util.ts",
    "./db/selectRows.util": "./src/db/selectRows.util.ts",
    "./errors/getErrorMessage.util": "./src/errors/getErrorMessage.util.ts",
    "./records/dropNullishValues.util": "./src/records/dropNullishValues.util.ts",
    "./tokens/generateApiToken.util": "./src/tokens/generateApiToken.util.ts",
    "./tokens/parseApiToken.util": "./src/tokens/parseApiToken.util.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp run --filter eslint-local-rules-shared build && vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp run --filter eslint-local-rules-shared build && vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/vite-configs": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}

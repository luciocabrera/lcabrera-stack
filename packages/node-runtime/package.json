{
  "name": "@lcabrera/node",
  "version": "0.2.1",
  "private": false,
  "description": "Process-lifecycle primitives for long-running Node services — graceful shutdown on the signals a container runtime actually sends.",
  "keywords": [
    "graceful-shutdown",
    "node",
    "sigint",
    "signals",
    "sigterm"
  ],
  "homepage": "https://github.com/luciocabrera/lcabrera-stack/tree/main/packages/node-runtime#readme",
  "bugs": "https://github.com/luciocabrera/lcabrera-stack/issues",
  "license": "MIT",
  "author": "Lucio Cabrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciocabrera/lcabrera-stack.git",
    "directory": "packages/node-runtime"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.*",
    "!src/**/*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./registerShutdownSignals.util": "./src/registerShutdownSignals.util.ts"
  },
  "publishConfig": {
    "exports": {
      "./registerShutdownSignals.util": {
        "types": "./dist/registerShutdownSignals.util.d.mts",
        "default": "./dist/registerShutdownSignals.util.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "devDependencies": {
    "@lcabrera/vite-config": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

{
  "name": "@lcabrera/tsconfig",
  "version": "0.2.1",
  "private": false,
  "description": "Strict TypeScript config factories and a generator that writes a tsconfig per workspace — app (browser/bundler) and node variants.",
  "keywords": [
    "config",
    "generator",
    "monorepo",
    "tsconfig",
    "typescript"
  ],
  "homepage": "https://github.com/luciocabrera/lcabrera-stack/tree/main/packages/tsconfig#readme",
  "bugs": "https://github.com/luciocabrera/lcabrera-stack/issues",
  "license": "MIT",
  "author": "Lucio Cabrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciocabrera/lcabrera-stack.git",
    "directory": "packages/tsconfig"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.*",
    "!src/**/*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./generate": "./src/generate.ts",
    "./shared": "./src/tsconfig.shared.ts"
  },
  "publishConfig": {
    "exports": {
      "./generate": {
        "types": "./dist/generate.d.mts",
        "default": "./dist/generate.mjs"
      },
      "./shared": {
        "types": "./dist/tsconfig.shared.d.mts",
        "default": "./dist/tsconfig.shared.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "devDependencies": {
    "@lcabrera/vite-config": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:lint",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

{
  "name": "@lcabrera/ui",
  "version": "0.2.0",
  "private": false,
  "description": "React 19 component library built around a virtualized, filterable data table. StyleX-styled, React Router framework mode.",
  "keywords": [
    "components",
    "data-table",
    "react",
    "react-router",
    "stylex",
    "virtualization"
  ],
  "homepage": "https://github.com/luciocabrera/vite-react-compiler/tree/main/packages/ui#readme",
  "bugs": "https://github.com/luciocabrera/vite-react-compiler/issues",
  "license": "MIT",
  "author": "Lucio Cabrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciocabrera/vite-react-compiler.git",
    "directory": "packages/ui"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.*",
    "!src/benchmarks"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/public-api.ts",
    "./package.json": "./package.json",
    "./server": "./src/server.ts",
    "./entry/*": "./src/entry/*",
    "./routing/*": "./src/routing/*",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*",
    "./components/AppDocument": "./src/components/AppDocument/index.ts",
    "./components/AppShell": "./src/components/AppShell/index.ts",
    "./components/Card": "./src/components/Card/index.ts",
    "./components/Card/CardBody": "./src/components/Card/CardBody/index.ts",
    "./components/Card/CardDescription": "./src/components/Card/CardDescription/index.ts",
    "./components/Card/CardFooter": "./src/components/Card/CardFooter/index.ts",
    "./components/Card/CardHeader": "./src/components/Card/CardHeader/index.ts",
    "./components/Card/CardTitle": "./src/components/Card/CardTitle/index.ts",
    "./components/Icons": "./src/components/Icons/index.ts",
    "./components/JsonExplorer": "./src/components/JsonExplorer/index.ts",
    "./components/RootErrorBoundary": "./src/components/RootErrorBoundary/index.ts",
    "./components/Table/utils": "./src/components/Table/utils/index.ts",
    "./components/VirtualList": "./src/components/VirtualList/index.ts",
    "./components/VirtualSelect/hooks": "./src/components/VirtualSelect/hooks/index.ts",
    "./components/VirtualSelect/VirtualSelectTrigger/hooks": "./src/components/VirtualSelect/VirtualSelectTrigger/hooks/index.ts",
    "./components/*": "./src/components/*",
    "./contexts/*": "./src/contexts/*",
    "./types/*": "./src/types/*",
    "./utils/logger": "./src/utils/logger/index.ts",
    "./utils/*": "./src/utils/*",
    "./design-system/*": "./src/design-system/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check:public-api": "node ./scripts/check-public-api-client-safe.mjs",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp run check:public-api && vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp run check:public-api && vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "vp run check:public-api && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@lcabrera/api": "workspace:*",
    "@lcabrera/utils": "workspace:*",
    "isbot": "catalog:react",
    "react-markdown": "catalog:react"
  },
  "devDependencies": {
    "@babel/preset-typescript": "catalog:build",
    "@eslint/js": "catalog:lint",
    "@react-router/node": "catalog:react",
    "@repo/vite-configs": "workspace:*",
    "@stylexjs/eslint-plugin": "catalog:react",
    "@stylexjs/stylex": "catalog:react",
    "@stylexjs/unplugin": "catalog:react",
    "@testing-library/react": "catalog:test",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "babel-plugin-react-compiler": "catalog:react",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-plugin-local-rules": "catalog:lint",
    "eslint-plugin-perfectionist": "catalog:lint",
    "eslint-plugin-react-dom": "catalog:lint",
    "eslint-plugin-react-hooks": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "eslint-plugin-react-x": "catalog:lint",
    "eslint-plugin-security": "catalog:lint",
    "eslint-plugin-unicorn": "catalog:lint",
    "globals": "catalog:lint",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-router": "catalog:react",
    "typescript": "catalog:build",
    "typescript-eslint": "catalog:lint",
    "vite": "catalog:build",
    "vite-plugin-babel": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@react-router/node": "^8.0.0",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@react-router/node": {
      "optional": true
    }
  }
}

{
  "name": "@lcabrera/ui",
  "version": "0.2.0",
  "private": false,
  "description": "React 19 component library built around a virtualized, filterable data table. StyleX-styled, React Router framework mode.",
  "keywords": [
    "components",
    "data-table",
    "react",
    "react-router",
    "stylex",
    "virtualization"
  ],
  "homepage": "https://github.com/luciocabrera/vite-react-compiler/tree/main/packages/ui#readme",
  "bugs": "https://github.com/luciocabrera/vite-react-compiler/issues",
  "license": "MIT",
  "author": "Lucio Cabrera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciocabrera/vite-react-compiler.git",
    "directory": "packages/ui"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "!src/**/*.test.*",
    "!src/benchmarks"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#ui/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx",
        "./src/*/index.ts",
        "./src/*/index.tsx"
      ],
      "default": "./src/*"
    }
  },
  "exports": {
    ".": "./src/public-api.ts",
    "./components/AppDocument": "./src/components/AppDocument/index.ts",
    "./components/AppShell": "./src/components/AppShell/index.ts",
    "./components/Button": "./src/components/Button/index.ts",
    "./components/Card": "./src/components/Card/index.ts",
    "./components/Card/CardBody": "./src/components/Card/CardBody/index.ts",
    "./components/Card/CardDescription": "./src/components/Card/CardDescription/index.ts",
    "./components/Card/CardFooter": "./src/components/Card/CardFooter/index.ts",
    "./components/Card/CardHeader": "./src/components/Card/CardHeader/index.ts",
    "./components/Card/CardTitle": "./src/components/Card/CardTitle/index.ts",
    "./components/Form": "./src/components/Form/index.ts",
    "./components/Form/Form.types": "./src/components/Form/Form.types.ts",
    "./components/Icons": "./src/components/Icons/index.ts",
    "./components/JsonExplorer": "./src/components/JsonExplorer/index.ts",
    "./components/MarkdownRenderer": "./src/components/MarkdownRenderer/index.ts",
    "./components/Modal": "./src/components/Modal/index.ts",
    "./components/NavLink": "./src/components/NavLink/index.ts",
    "./components/Navbar/Navbar.types": "./src/components/Navbar/Navbar.types.ts",
    "./components/RootErrorBoundary": "./src/components/RootErrorBoundary/index.ts",
    "./components/RouteErrorBoundary": "./src/components/RouteErrorBoundary/index.ts",
    "./components/SectionCard": "./src/components/SectionCard/index.ts",
    "./components/Settings/Settings.component": "./src/components/Settings/Settings.component.tsx",
    "./components/Settings/settings.meta": "./src/components/Settings/settings.meta.ts",
    "./components/SidePanel": "./src/components/SidePanel/index.ts",
    "./components/StatusBadge": "./src/components/StatusBadge/index.ts",
    "./components/Table": "./src/components/Table/index.ts",
    "./components/Table/Table.constants": "./src/components/Table/Table.constants.ts",
    "./components/Table/Table.types": "./src/components/Table/Table.types.ts",
    "./components/Table/TableLayout": "./src/components/Table/TableLayout/index.ts",
    "./components/Table/contexts/TableConfig/utils": "./src/components/Table/contexts/TableConfig/utils/index.ts",
    "./components/Table/utils": "./src/components/Table/utils/index.ts",
    "./components/Table/utils/createEmptyColumnsState.util": "./src/components/Table/utils/createEmptyColumnsState.util.ts",
    "./components/Table/utils/inferTableColumnsFromJson.util": "./src/components/Table/utils/inferTableColumnsFromJson.util.ts",
    "./components/TrendSparkline": "./src/components/TrendSparkline/index.ts",
    "./components/VirtualList": "./src/components/VirtualList/index.ts",
    "./components/VirtualSelect": "./src/components/VirtualSelect/index.ts",
    "./components/VirtualSelect/VirtualSelectTrigger/hooks": "./src/components/VirtualSelect/VirtualSelectTrigger/hooks/index.ts",
    "./components/VirtualSelect/hooks": "./src/components/VirtualSelect/hooks/index.ts",
    "./contexts/NotificationContext": "./src/contexts/NotificationContext/index.ts",
    "./contexts/NotificationContext/actions": "./src/contexts/NotificationContext/actions/index.ts",
    "./contexts/NotificationContext/selectors": "./src/contexts/NotificationContext/selectors/index.ts",
    "./contexts/ThemeContext": "./src/contexts/ThemeContext/index.ts",
    "./design-system/constants": "./src/design-system/constants/index.ts",
    "./design-system/reset.css": "./src/design-system/reset.css",
    "./design-system/tokens/base.stylex": "./src/design-system/tokens/base.stylex.ts",
    "./design-system/tokens/colors.stylex": "./src/design-system/tokens/colors.stylex.ts",
    "./design-system/tokens/commons.stylex": "./src/design-system/tokens/commons.stylex.ts",
    "./entry/hydrateApp.util": "./src/entry/hydrateApp.util.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/useTheme.hook": "./src/hooks/useTheme.hook.ts",
    "./package.json": "./package.json",
    "./routing/actions/persist-cookie.action": "./src/routing/actions/persist-cookie.action.ts",
    "./routing/actions/shouldRevalidatePersistCookieAction.util": "./src/routing/actions/shouldRevalidatePersistCookieAction.util.ts",
    "./routing/loaders/createTableRouteLoader.util": "./src/routing/loaders/createTableRouteLoader.util.ts",
    "./routing/shared/getRootLoaderData.util": "./src/routing/shared/getRootLoaderData.util.ts",
    "./routing/shared/sanitizeSorting.util": "./src/routing/shared/sanitizeSorting.util.ts",
    "./routing/shared/toQuerySort.util": "./src/routing/shared/toQuerySort.util.ts",
    "./server": "./src/server.ts",
    "./types/filterOperators.types": "./src/types/filterOperators.types.ts",
    "./utils/filters": "./src/utils/filters/index.ts",
    "./utils/logger": "./src/utils/logger/index.ts",
    "./utils/tests/mockDialogElement.util": "./src/utils/tests/mockDialogElement.util.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check:public-api": "node ./scripts/check-public-api-client-safe.mjs",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp run check:public-api && vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp run check:public-api && vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "vp run check:public-api && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@lcabrera/api": "workspace:*",
    "@lcabrera/utils": "workspace:*",
    "isbot": "catalog:react",
    "react-markdown": "catalog:react"
  },
  "devDependencies": {
    "@babel/preset-typescript": "catalog:build",
    "@eslint/js": "catalog:lint",
    "@lcabrera/vite-config": "workspace:*",
    "@react-router/node": "catalog:react",
    "@stylexjs/eslint-plugin": "catalog:react",
    "@stylexjs/stylex": "catalog:react",
    "@stylexjs/unplugin": "catalog:react",
    "@testing-library/react": "catalog:test",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "babel-plugin-react-compiler": "catalog:react",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-plugin-local-rules": "catalog:lint",
    "eslint-plugin-perfectionist": "catalog:lint",
    "eslint-plugin-react-dom": "catalog:lint",
    "eslint-plugin-react-hooks": "catalog:lint",
    "eslint-plugin-react-refresh": "catalog:lint",
    "eslint-plugin-react-x": "catalog:lint",
    "eslint-plugin-security": "catalog:lint",
    "eslint-plugin-unicorn": "catalog:lint",
    "globals": "catalog:lint",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-router": "catalog:react",
    "typescript": "catalog:build",
    "typescript-eslint": "catalog:lint",
    "vite": "catalog:build",
    "vite-plugin-babel": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  },
  "peerDependencies": {
    "@react-router/node": "^8.0.0",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@react-router/node": {
      "optional": true
    }
  }
}

{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "files": [
    "src",
    "!src/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/public-api.ts",
    "./server": "./src/server.ts",
    "./entry/*": "./src/entry/*",
    "./routing/*": "./src/routing/*",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*",
    "./components/AppDocument": "./src/components/AppDocument/index.ts",
    "./components/AppShell": "./src/components/AppShell/index.ts",
    "./components/Card": "./src/components/Card/index.ts",
    "./components/Card/CardBody": "./src/components/Card/CardBody/index.ts",
    "./components/Card/CardDescription": "./src/components/Card/CardDescription/index.ts",
    "./components/Card/CardFooter": "./src/components/Card/CardFooter/index.ts",
    "./components/Card/CardHeader": "./src/components/Card/CardHeader/index.ts",
    "./components/Card/CardTitle": "./src/components/Card/CardTitle/index.ts",
    "./components/Icons": "./src/components/Icons/index.ts",
    "./components/JsonExplorer": "./src/components/JsonExplorer/index.ts",
    "./components/RootErrorBoundary": "./src/components/RootErrorBoundary/index.ts",
    "./components/Table/utils": "./src/components/Table/utils/index.ts",
    "./components/VirtualList": "./src/components/VirtualList/index.ts",
    "./components/VirtualSelect/hooks": "./src/components/VirtualSelect/hooks/index.ts",
    "./components/VirtualSelect/VirtualSelectTrigger/hooks": "./src/components/VirtualSelect/VirtualSelectTrigger/hooks/index.ts",
    "./components/*": "./src/components/*",
    "./contexts/*": "./src/contexts/*",
    "./types/*": "./src/types/*",
    "./utils/logger": "./src/utils/logger/index.ts",
    "./utils/*": "./src/utils/*",
    "./design-system/*": "./src/design-system/*"
  },
  "scripts": {
    "check:public-api": "node ./scripts/check-public-api-client-safe.mjs",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp run check:public-api && vp run --filter eslint-local-rules-shared build && vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp run check:public-api && vp run --filter eslint-local-rules-shared build && vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "vp run check:public-api && tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@repo/api": "workspace:*",
    "@repo/utils": "workspace:*",
    "isbot": "catalog:",
    "react-markdown": "catalog:"
  },
  "devDependencies": {
    "@babel/preset-typescript": "catalog:",
    "@eslint/js": "catalog:",
    "@react-router/node": "catalog:",
    "@repo/vite-configs": "workspace:*",
    "@stylexjs/eslint-plugin": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@stylexjs/unplugin": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-local-rules": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-react-dom": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "eslint-plugin-react-x": "catalog:",
    "eslint-plugin-security": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-babel": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@react-router/node": "^8.0.0",
    "@stylexjs/stylex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@react-router/node": {
      "optional": true
    }
  }
}

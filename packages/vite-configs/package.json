{
  "name": "@repo/vite-configs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./fmt": "./vite.fmt.shared.config.ts",
    "./eslint-custom-rules": "./eslint.custom-rules.shared.config.mjs",
    "./eslint-base-custom-rules": "./eslint.base-custom-rules.shared.config.mjs",
    "./lint": "./vite.lint.shared.config.ts",
    "./pack": "./vite.pack.shared.config.ts",
    "./plugins": "./vite.plugins.shared.config.ts",
    "./run": "./vite.run.shared.config.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "node node_modules/vitest/vitest.mjs run --passWithNoTests"
  },
  "devDependencies": {
    "@babel/preset-typescript": "catalog:build",
    "@eslint/js": "catalog:lint",
    "@lcabrera/eslint-plugin": "workspace:*",
    "@lcabrera/utils": "workspace:*",
    "@react-router/dev": "catalog:react",
    "@repo/plugins": "workspace:*",
    "@stylexjs/unplugin": "catalog:react",
    "@types/node": "catalog:types",
    "babel-plugin-react-compiler": "catalog:react",
    "eslint": "catalog:lint",
    "eslint-config-prettier": "catalog:lint",
    "eslint-plugin-perfectionist": "catalog:lint",
    "eslint-plugin-security": "catalog:lint",
    "eslint-plugin-unicorn": "catalog:lint",
    "globals": "catalog:lint",
    "typescript": "catalog:build",
    "typescript-eslint": "catalog:lint",
    "vite": "catalog:build",
    "vite-plugin-babel": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  }
}

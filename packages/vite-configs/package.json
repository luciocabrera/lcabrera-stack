{
  "name": "@repo/vite-configs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./fmt": "./vite.fmt.shared.config.ts",
    "./base-lint": "./vite.base-lint.shared.config.ts",
    "./eslint-custom-rules": "./eslint.custom-rules.shared.config.mjs",
    "./eslint-base-custom-rules": "./eslint.base-custom-rules.shared.config.mjs",
    "./frontend-lint": "./vite.frontend-lint.shared.config.ts",
    "./api-lint": "./vite.api-lint.shared.config.ts",
    "./react-router-lint": "./vite.react-router-lint.shared.config.ts",
    "./plugins": "./vite.plugins.shared.config.ts",
    "./run": "./vite.run.shared.config.ts"
  },
  "scripts": {
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp run --filter eslint-local-rules-shared build && vp lint . --fix && vp run lint:eslint",
    "lint:check": "vp run --filter eslint-local-rules-shared build && vp lint . && vp run lint:eslint:check",
    "lint:eslint": "eslint . --config eslint.config.mjs --fix --max-warnings 0",
    "lint:eslint:check": "eslint . --config eslint.config.mjs --max-warnings 0",
    "test": "node node_modules/vitest/vitest.mjs run --passWithNoTests"
  },
  "devDependencies": {
    "@babel/preset-typescript": "catalog:",
    "@eslint/js": "catalog:",
    "@react-router/dev": "catalog:",
    "@repo/plugins": "workspace:*",
    "@repo/utils": "workspace:*",
    "@stylexjs/unplugin": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-security": "catalog:",
    "eslint-plugin-unicorn": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:",
    "vite-plugin-babel": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}

POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=postgres
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=root

API_PORT=3001
DB_HOST=localhost
DB_PORT=5434
DB_USER=root
DB_PASSWORD=root
DB_NAME=car_sales_db

# Connection-pool tuning, read by @lcabrera/server's getPool() in every Node
# consumer. They are
# optional — the defaults shown are what applies when the key is absent, so an
# existing .env keeps working untouched. They exist so the process degrades
# gracefully under load instead of stalling silently: pg on its own waits forever
# to acquire a connection and puts no ceiling on a statement.
#DB_POOL_MAX=10                 # max connections per process (pg's own default)
#DB_CONNECTION_TIMEOUT_MS=10000 # give up acquiring a connection (pg: waits forever)
#DB_IDLE_TIMEOUT_MS=10000       # close an idle connection (pg's own default)
#DB_STATEMENT_TIMEOUT_MS=30000  # server-side per-statement ceiling (pg: none)

ENTERPRISE_ORDERS_DELAY_MS=3000
DISTINCT_VALUES_DELAY_MS=10000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Eval history (packages/eval-history). Every `vp run evals:*` command loads
# this file, and a variable already set in the environment wins over it. With
# EVALS_DATABASE_URL unset, a run's envelope stays under .tmp/eval-results/
# until `vp run evals:ingest`. Create the database once with
# `create database eval_history`; `vp run evals:migrate` prints the role setup.
# Keep `$` out of these passwords: docker compose interpolates it when it reads
# this file and node does not, so the two would see different values.
#EVALS_DATABASE_URL=postgres://evals_writer:<password>@localhost:5434/eval_history
#EVALS_MIGRATE_DATABASE_URL=postgres://evals_migrator:<password>@localhost:5434/eval_history
{
  "permissions": {
    "allow": [
      "Bash(vp fmt*)",
      "Bash(vp lint*)",
      "Bash(vp check*)",
      "Bash(vp install)",
      "Bash(vp run *)",
      "Bash(cd apps/react-router && vp fmt*)",
      "Bash(cd apps/react-router && vp lint*)",
      "Bash(cd apps/react-router && vp check*)",
      "Bash(cd apps/react-router && vp run test*)",
      "Bash(react-router typegen *)",
      "Bash(tsc --noEmit)",
      "Bash(node scripts/validate-skills.cjs*)",
      "Bash(node node_modules/vitest/vitest.mjs run *)",
      "Bash(node apps/react-router/node_modules/vitest/vitest.mjs run *)",
      "Bash(bash .github/skills/code-smell-zen/scripts/collect-diff.sh*)",
      "Bash(bash .github/skills/fallow-code-checker/scripts/run-fallow.sh*)",
      "Bash(node --env-file-if-exists=docker/local/.env --env-file-if-exists=packages/scan-ingestion/.env --experimental-strip-types packages/scan-ingestion/src/cli/ingest.cli.ts*)",
      "Bash(node .github/skills/linter-checker/scripts/generate-eslint-report.mjs*)",
      "Bash(node .github/skills/linter-checker/scripts/generate-oxlint-report.mjs*)",
      "Write(.tmp/**)",
      "Edit(.tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Read|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-secrets-guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-autofix.mjs"
          }
        ]
      }
    ]
  }
}

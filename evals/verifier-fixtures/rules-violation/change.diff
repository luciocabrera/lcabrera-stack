@@ -0,0 +1,13 @@
+interface ClampNumberArgs {
+  max: number;
+  min: number;
+  value: number;
+}
+
+export const clampNumber = ({ max, min, value }: ClampNumberArgs) => {
+  if (min > max) {
+    throw new RangeError(`min (${min}) is greater than max (${max})`);
+  }
+
+  return Math.min(Math.max(value, min), max);
+};

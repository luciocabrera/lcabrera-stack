+import { describe, expect, it } from 'vite-plus/test';
+
+import { clampNumber } from './clamp-number.util';
+
+describe('clampNumber', () => {
+  it('returns min when the value is below it', () => {
+    expect(clampNumber({ max: 10, min: 0, value: -5 })).toBe(0);
+  });
+
+  it('returns max when the value is above it', () => {
+    expect(clampNumber({ max: 10, min: 0, value: 15 })).toBe(10);
+  });
+
+  it('returns the value when it is within the bounds', () => {
+    expect(clampNumber({ max: 10, min: 0, value: 7 })).toBe(7);
+  });
+
+  it('throws a RangeError when min is greater than max', () => {
+    expect(() => clampNumber({ max: 0, min: 10, value: 5 })).toThrow(
+      RangeError,
+    );
+  });
+});

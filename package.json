{
  "name": "vite-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:all": "vp run -r build",
    "test:all": "vp run -r test",
    "lint:all": "vp run --filter eslint-local-rules-shared build && vp lint . --fix && vp run -r lint:eslint && vp run lint:biome",
    "lint:biome": "biome lint . --write",
    "lint:biome:check": "biome lint .",
    "lint:report": "vp run --filter eslint-local-rules-shared build && node scripts/generate-lint-reports.mjs",
    "coverage:merge": "node scripts/merge-coverage.mjs",
    "coverage:report": "node scripts/coverage-report.mjs",
    "format:all": "vp fmt .",
    "typegen:all": "vp run -r typegen",
    "typecheck:all": "vp run -r typecheck",
    "check:safe": "vp run typegen:all && vp run --filter eslint-local-rules-shared build && vp check && vp run typecheck:all && vp run -r lint:eslint:check && vp run lint:biome:check && vp run test:all",
    "test:ci": "vp run --filter '!@repo/scan-ingestion' --filter '!@repo/scan-orchestrator' --filter '!vite-react-compiler' test && vp run --filter @repo/scan-ingestion test:unit && vp run --filter @repo/scan-orchestrator test:unit && vp run --filter vite-react-compiler test:ci",
    "ready": "vp run check:safe && vp run build:all",
    "dev": "vp run --parallel --filter car-sales-api --filter vite-react-compiler dev",
    "dev:fast": "vp run --parallel --filter car-sales-api-fast --filter vite-react-compiler dev",
    "dev:cqms": "vp run --parallel --filter admin-system --filter @repo/scan-orchestrator dev",
    "start": "vp run --parallel --filter car-sales-api --filter vite-react-compiler start",
    "start:fast": "vp run --parallel --filter car-sales-api-fast --filter vite-react-compiler start",
    "start:cqms": "vp run --parallel --filter admin-system --filter @repo/scan-orchestrator start",
    "db:up": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env up -d postgres pgadmin",
    "db:status": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env ps",
    "db:down": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env down",
    "commands:verify": "node scripts/verify-commands-doc.mjs",
    "commit:verify": "node scripts/verify-commit-msg.mjs",
    "pr:verify": "node scripts/verify-pr.mjs",
    "coordination:verify": "node scripts/verify-coordination.mjs",
    "coordination:board": "node scripts/verify-coordination.mjs --write-board",
    "sonar:report": "node scripts/sonar-report.mjs",
    "sonar:verify": "node scripts/sonar-report.mjs --gate",
    "scripts:verify": "node scripts/verify-script-size.mjs",
    "skills:validate": "node scripts/validate-skills.cjs",
    "skills:report": "node scripts/generate-skills-compliance-report.cjs",
    "skills:source-audit": "node scripts/generate-source-smell-report.cjs && node scripts/bootstrap-agenting-handoff.cjs",
    "skills:handoff": "node scripts/bootstrap-agenting-handoff.cjs",
    "fallow:full": "fallow",
    "fallow:dead-code": "fallow dead-code",
    "fallow:health": "fallow health --file-scores --hotspots --targets --score",
    "fallow:dupes": "fallow dupes",
    "fallow:audit": "fallow audit",
    "fallow:refresh-report": "node scripts/refresh-fallow-complexity-report.cjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@repo/vite-configs": "workspace:*",
    "fallow": "catalog:",
    "ts-morph": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}

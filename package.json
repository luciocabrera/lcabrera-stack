{
  "name": "vite-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test -r && vp run build -r",
    "dev": "pnpm --parallel --filter car-sales-api --filter vite-react-compiler run dev",
    "dev:fast": "pnpm --parallel --filter car-sales-api-fast --filter vite-react-compiler run dev",
    "start": "vp run start -r",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0"
}

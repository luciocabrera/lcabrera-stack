{
  "name": "vite-react-compiler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:eslint-rules": "tsc -p eslint-local-rules/tsconfig.json",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "vp lint . --fix",
    "lint:check": "vp lint .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "preview": "vp preview",
    "knip": "knip",
    "prepare": "vp config"
  },
  "dependencies": {
    "@react-router/node": "^7.13.1",
    "@react-router/serve": "^7.13.1",
    "@stylexjs/stylex": "^0.18.1",
    "isbot": "^5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.13.1",
    "@stylexjs/eslint-plugin": "^0.18.1",
    "@stylexjs/unplugin": "^0.18.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-local-rules": "^3.0.2",
    "eslint-plugin-perfectionist": "^5.7.0",
    "eslint-plugin-react-dom": "^3.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-x": "^3.0.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.4.0",
    "knip": "^5.88.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "unplugin": "^3.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-babel": "^1.5.1",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    }
  }
}

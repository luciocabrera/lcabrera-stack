{
  "name": "lcabrera-stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "adr:list": "repo-verify-adrs --list",
    "adr:new": "repo-adr",
    "adr:verify": "repo-verify-adrs",
    "agent-review:verify": "node scripts/verify-agent-review.mjs",
    "api-surface:verify": "repo-verify-api-surface",
    "attw:verify": "repo-verify-types",
    "bench:array-ops": "node scripts/bench-array-operations.mjs",
    "branch:verify": "repo-verify-branch",
    "build:all": "vp run -r build",
    "changelog:generate": "git log --no-merges --format=%H%x1f%D%x1f%cI%x1f%s%x1f%b%x1e -- ':!CHANGELOG.md' | node scripts/generate-changelog.mjs",
    "check:push": "vp run typegen:all && vp check && vp run typecheck:changed && vp run -r lint:eslint:check && vp run lint:biome:check && vp run react-doctor:verify && vp run commands:verify && vp run coordination:verify && vp run scripts:verify && vp run scripts:exits:verify && vp run seeds:verify && vp run devkit:closure -- --shipped && vp run devkit:check && vp run lint:plugins:verify && vp run lint:eslint:verify && vp run suppressions:verify && vp run docs:verify && vp run harness:verify && vp run registers:verify && vp run package-refs:verify && vp run departed:verify && vp run renames:verify && vp run route-names:verify && vp run inventory:verify && vp run adr:verify && vp run viteplus:verify && vp run configs:verify",
    "check:safe": "vp run typegen:all && vp check && vp run typecheck:all && vp run -r lint:eslint:check && vp run lint:biome:check && vp run react-doctor:verify && vp run commands:verify && vp run coordination:verify && vp run scripts:verify && vp run scripts:exits:verify && vp run seeds:verify && vp run devkit:closure -- --shipped && vp run devkit:check && vp run lint:plugins:verify && vp run lint:eslint:verify && vp run suppressions:verify && vp run docs:verify && vp run harness:verify && vp run registers:verify && vp run package-refs:verify && vp run departed:verify && vp run renames:verify && vp run route-names:verify && vp run inventory:verify && vp run adr:verify && vp run viteplus:verify && vp run configs:verify && vp run deps:audit && vp run tarball:verify && vp run shipped-docs:verify && vp run packages:build && vp run publish:verify && vp run api-surface:verify && vp run attw:verify && vp run test:all",
    "commands:verify": "repo-verify-commands",
    "commit:verify": "repo-verify-commit",
    "configs:verify": "repo-verify-stray-configs",
    "coordination:board": "repo-verify-claims --write-board",
    "coordination:board:live": "gh pr list --state open --json number,title,headRefName,isDraft,url,statusCheckRollup --limit 200 | repo-claim-board",
    "coordination:claim": "bash scripts/coordination-claim.sh",
    "coordination:close": "repo-close-claim",
    "coordination:verify": "repo-verify-claims",
    "copilot-review:status": "node scripts/copilot-review-status.mjs",
    "copilot-review:suppressed": "node scripts/copilot-suppressed-comments.mjs",
    "coverage:merge": "bash scripts/changed-files.sh --if-arg --changed repo-merge-coverage",
    "coverage:report": "bash scripts/changed-files.sh --if-arg --changed repo-coverage-report",
    "db:down": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env down",
    "db:status": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env ps",
    "db:up": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env up -d postgres pgadmin",
    "departed:verify": "repo-verify-departed-names",
    "deps:audit": "vp pm audit --json | repo-verify-deps-audit",
    "deps:refresh": "bash scripts/deps-refresh.sh",
    "dev:showcase": "vp run --filter showcase dev",
    "devkit:check": "devkit doctor --check",
    "devkit:closure": "devkit closure",
    "devkit:doctor": "devkit doctor",
    "devkit:sync": "devkit sync",
    "docs:for-package": "repo-docs-for-package",
    "docs:verify": "repo-verify-docs-paths",
    "fallow:audit": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:full": "fallow",
    "fallow:health": "fallow health --file-scores --hotspots --targets --score",
    "fallow:refresh-report": "node scripts/refresh-fallow-complexity-report.cjs",
    "fallow:report": "bash scripts/fallow-report.sh",
    "format:all": "vp fmt .",
    "harness:verify": "repo-verify-harness",
    "housekeeping:prune": "gh pr list --state all --json number,headRefName,state --limit 400 | repo-housekeeping-prune",
    "inventory:verify": "repo-verify-inventory",
    "issue:verify": "repo-verify-issue",
    "labels:sync": "node scripts/sync-labels.mjs",
    "lint:all": "vp lint . --fix && vp run -r lint:eslint && vp run lint:biome",
    "lint:biome": "biome lint . --write",
    "lint:biome:check": "biome lint .",
    "lint:eslint:verify": "repo-verify-eslint-pass",
    "lint:plugins:verify": "repo-verify-lint-plugins",
    "lint:report": "repo-lint-report",
    "package-refs:verify": "repo-verify-package-refs",
    "packages:build": "vp run --filter '@lcabrera/*' build",
    "plan:issues": "node scripts/plan-issues.mjs",
    "pr:queue": "node scripts/pr-queue-operator.mjs",
    "pr:threads": "repo-pr-threads",
    "pr:verify": "repo-verify-pr",
    "prepare": "vp config",
    "product:distance": "repo-product-distance",
    "publish:verify": "repo-verify-publish",
    "react-doctor:report": "repo-verify-react-doctor --report",
    "react-doctor:verify": "repo-verify-react-doctor",
    "ready": "vp run check:safe && vp run build:all",
    "registers:verify": "repo-verify-doc-registers",
    "release:add": "changeset",
    "release:audit": "repo-audit-release",
    "release:plan": "repo-plan-release",
    "release:status": "changeset status --since origin/main",
    "release:version": "changeset version && vp install --lockfile-only && vp fmt .",
    "renames:verify": "repo-verify-renamed-mentions",
    "review-gates:reconcile": "node scripts/reconcile-review-gates.mjs",
    "review-threads:verify": "repo-verify-review-threads",
    "route-names:verify": "repo-verify-route-artifacts",
    "scripts:exits:verify": "repo-verify-script-exits",
    "scripts:verify": "repo-verify-script-size",
    "seeds:verify": "node scripts/verify-devkit-seeds.mjs",
    "shipped-docs:verify": "repo-verify-shipped-docs",
    "skills:report": "node scripts/generate-skills-compliance-report.cjs",
    "skills:validate": "node scripts/validate-skills.cjs",
    "sonar:report": "node scripts/sonar-report.mjs",
    "sonar:verify": "node scripts/sonar-report.mjs --gate",
    "start:showcase": "vp run --filter showcase start",
    "suppressions:list": "node scripts/verify-suppressions.mjs --list",
    "suppressions:packages": "node scripts/verify-suppressions.mjs --packages",
    "suppressions:verify": "node scripts/verify-suppressions.mjs",
    "tarball:verify": "node scripts/verify-devkit-tarball.mjs",
    "test:all": "vp run -r test && vp run test:scripts",
    "test:changed": "bash scripts/changed-files.sh repo-test-changed",
    "test:ci": "vp run --filter '!showcase' test && vp run test:scripts && vp run --filter showcase test:ci",
    "test:scripts": "node node_modules/vitest/vitest.mjs run --root scripts",
    "typecheck:all": "vp run -r typecheck",
    "typecheck:changed": "bash scripts/changed-files.sh repo-run-changed typecheck",
    "typegen:all": "vp run -r typegen",
    "usage:report": "repo-usage-report",
    "viteplus:verify": "repo-verify-viteplus-block",
    "worktree:env": "repo-worktree-env"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:tooling",
    "@biomejs/biome": "catalog:lint",
    "@changesets/cli": "catalog:tooling",
    "@changesets/get-release-plan": "catalog:tooling",
    "@lcabrera/devkit": "workspace:*",
    "@lcabrera/repo-standards": "workspace:*",
    "@lcabrera/vite-config": "workspace:*",
    "@vitest/coverage-v8": "catalog:test",
    "fallow": "catalog:tooling",
    "react-doctor": "catalog:lint",
    "ts-morph": "catalog:tooling",
    "vite": "catalog:build",
    "vite-plus": "catalog:build",
    "vitest": "catalog:test"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@11.25.0+sha256.33dd0748f27e7916c4f1c8b6943461983e3453b06bbda6312a6280130b4881e5"
}

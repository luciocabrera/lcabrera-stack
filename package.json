{
  "name": "vite-react-compiler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:eslint-rules": "tsc -p eslint-local-rules/tsconfig.json",
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "preview": "vite preview",
    "knip": "knip"
  },
  "dependencies": {
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@stylexjs/stylex": "^0.17.5",
    "isbot": "^5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "^7.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@react-router/dev": "^7.12.0",
    "@stylexjs/eslint-plugin": "^0.17.5",
    "@stylexjs/unplugin": "^0.17.5",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.3.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-dom": "^2.7.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-react-x": "^2.7.2",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.0.0",
    "knip": "^5.82.1",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "unplugin": "^2.3.11",
    "vite": "^7.3.1",
    "vite-plugin-babel": "^1.4.1"
  }
}

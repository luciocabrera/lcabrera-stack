{
  "name": "vite-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:eslint-rules": "cd packages/eslint-local-rules && vp run build",
    "build:all": "vp run -r build",
    "check:safe": "vp run typegen:router && vp run build:eslint-rules && vp check && cd apps/react-router && REACT_ROUTER_TEST_TASK=true vp run test",
    "test:ci": "cd apps/react-router && REACT_ROUTER_TEST_TASK=true vp test --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "ready": "vp run check:safe && vp run build:all",
    "dev": "pnpm --parallel --filter car-sales-api --filter vite-react-compiler run dev",
    "dev:fast": "pnpm --parallel --filter car-sales-api-fast --filter vite-react-compiler run dev",
    "db:up": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env up -d postgres pgadmin",
    "db:status": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env ps",
    "db:down": "docker compose -f docker/local/docker-compose.yml --env-file docker/local/.env down",
    "db:seed": "vp run db:up && vp run seed",
    "seed": "cd apps/api-server && vp run seed",
    "seed:fast": "cd apps/api-server-fast && vp run seed",
    "start": "vp run start -r",
    "test": "cd apps/react-router && REACT_ROUTER_TEST_TASK=true vp run test",
    "skills:validate": "node scripts/validate-skills.cjs",
    "skills:report": "node scripts/generate-skills-compliance-report.cjs",
    "skills:source-audit": "node scripts/generate-source-smell-report.cjs && node scripts/bootstrap-agenting-handoff.cjs",
    "skills:handoff": "node scripts/bootstrap-agenting-handoff.cjs",
    "typegen:router": "cd apps/react-router && vp run typegen",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@repo/vite-configs": "workspace:*",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=25"
  },
  "packageManager": "pnpm@11.5.3"
}

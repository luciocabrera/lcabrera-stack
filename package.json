{
  "name": "vite-react-compiler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:eslint-rules": "tsc -p eslint-local-rules/tsconfig.json",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "knip": "knip"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.17.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylexjs/eslint-plugin": "^0.17.4",
    "@stylexjs/unplugin": "^0.17.4",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.1.0",
    "eslint-plugin-react-dom": "^2.4.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-react-x": "^2.4.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "knip": "^5.77.4",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "unplugin": "^2.3.11",
    "vite": "^7.3.0"
  }
}

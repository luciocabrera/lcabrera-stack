{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "eslint-local-rules/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["eslint-local-rules/build/**"],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"]
}

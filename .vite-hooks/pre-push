#!/usr/bin/env sh
# pre-push: run the DB-free CI gate locally, before anything reaches CI.
#
# Why this exists: the pre-commit hook runs `vp staged` (fmt + Oxlint + tsgolint
# + Biome on staged files) but NOT the ESLint pass or a full type-check, so an
# ESLint-only finding (unicorn / perfectionist / local-rules) or a cross-file
# type error first turns red in CI. `check:push` mirrors the
# "Quality Gate (Format · Lint · Types)" job in
# .github/workflows/check-safe.yml — the same checks, run the same way — so a
# push that would fail that job fails here first.
#
# Tests run too, but only for the workspaces the push actually touches.
# `test:changed` diffs against the merge base, asks the workspace graph which
# groups cover the changed paths, and runs those plus their dependents — so a
# docs-only push runs nothing. The whole suite is forced only by pnpm-lock.yaml,
# pnpm-workspace.yaml, the root vite.config.ts, or the shared config packages
# (@lcabrera/vite-config / @repo/ts-configs); a plain root file does NOT trigger it,
# because a real dependency change always moves the lockfile. That keeps a warm
# push quick while still catching the class of breakage no linter sees.
#
# Tests used to be omitted here, with the comment "the test suites need a
# database, which a hook cannot assume". That is no longer true: `test:ci` is
# DB-free by construction, and any workspace with real-Postgres suites exposes a
# DB-free `test:unit` subset that it substitutes. What made it worth bringing forward is that removing the Claude
# `Stop` hook left nothing running tests locally at all.
#
# The fallow audit still stays in CI: it is a new-only gate scored against the
# merge base, so it needs full history and a coverage merge.
#
# Bypass for a work-in-progress push: `git push --no-verify`.

# Must come before anything else: git exports GIT_DIR to hooks, and it overrides
# the working directory for every `git` a task spawns. Without this, a test that
# builds a throwaway repo instead rewrites the real index — see the script.
#
# Fail closed. A missing guard is not a reason to run the suite anyway: that is
# the configuration in which two commits were already lost.
__scrub="$(dirname "$0")/scrub-git-env.sh"
if [ ! -f "$__scrub" ]; then
  echo "✗ pre-push: $__scrub is missing."
  echo "  Refusing to run tasks while git's environment is inherited — a test"
  echo "  that creates a temp repo would rewrite this repository's index."
  exit 1
fi
. "$__scrub"

# Cheapest check first, and the one that is most annoying to fix late: a branch
# name cannot be corrected after the push without rewriting the remote, so it is
# worth failing before the suite runs rather than after. `main` and `release-*`
# are exempt; `vp run coordination:claim` produces a conforming name for you.
if ! vp run branch:verify; then
  echo ""
  echo "✗ pre-push: rename the branch, then push again."
  echo "  To push work-in-progress anyway: git push --no-verify"
  exit 1
fi

if ! vp run check:push; then
  echo ""
  echo "✗ pre-push gate failed — fix the findings above (they would fail CI)."
  echo "  To push work-in-progress anyway: git push --no-verify"
  exit 1
fi

if ! vp run test:changed; then
  echo ""
  echo "✗ pre-push tests failed — the affected workspaces do not pass."
  echo "  To push work-in-progress anyway: git push --no-verify"
  exit 1
fi

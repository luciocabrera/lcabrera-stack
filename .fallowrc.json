{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "scripts/**/*.{cjs,mjs,js}",
    ".github/skills/*/scripts/*.{js,mjs,cjs}",
    "packages/devkit/scripts/*.mjs",
    "packages/repo-standards/scripts/*.mjs",
    "apps/react-router/lighthouse.config.js",
    "apps/react-router/config/*.ts",
    "packages/ui/config/*.ts",
    "apps/*/scripts/**/*.{ts,js,mjs}"
  ],
  "ignorePatterns": [
    "**/build/**",
    "**/.react-router/**",
    "**/.tmp/**",
    "**/coverage/**",
    "reports/**"
  ],
  "ignoreDependencies": [
    "@arethetypeswrong/core",
    "@babel/preset-typescript",
    "@eslint/js",
    "@stylexjs/eslint-plugin",
    "@stylexjs/unplugin",
    "@typescript-eslint/utils",
    "babel-plugin-react-compiler",
    "eslint-config-prettier",
    "eslint-plugin-local-rules",
    "eslint-plugin-perfectionist",
    "eslint-plugin-react-dom",
    "eslint-plugin-react-hooks",
    "eslint-plugin-react-refresh",
    "eslint-plugin-react-x",
    "eslint-plugin-security",
    "eslint-plugin-unicorn",
    "globals",
    "ts-morph",
    "vite-plugin-babel",
    "typescript-eslint"
  ],
  "ignoreExports": [
    {
      "file": "apps/react-router/src/features/showcase/ShowcasePage/ShowcasePage.stylex.ts",
      "exports": ["*"]
    },
    {
      "file": "apps/react-router/src/features/showcase/ShowcasePage/SidePanelSection/SidePanelSection.stylex.ts",
      "exports": ["*"]
    }
  ],
  "health": {
    "maxUnitSize": 90,
    "thresholdOverrides": [
      {
        "files": ["**/*.test.*"],
        "maxCrap": 1000000,
        "maxUnitSize": 10000,
        "reason": "describe()/it() blocks in test suites legitimately span hundreds of lines, and CRAP scores untested complexity \u2014 a test file is never exercised by its own tests, so its coverage is either absent (estimated 0%) or meaningless, which inflates CRAP without signalling anything. Cyclomatic and cognitive limits still apply to test files."
      },
      {
        "files": [
          ".github/skills/**/*.mjs",
          "packages/repo-standards/scripts/verify-*.mjs",
          "packages/repo-standards/scripts/new-adr.mjs",
          "packages/repo-standards/scripts/close-coordination-claim.mjs",
          "packages/repo-standards/scripts/coordination-board-live.mjs",
          "packages/repo-standards/scripts/audit-release.mjs",
          "packages/repo-standards/scripts/release-publish-plan.mjs",
          "packages/eslint-local-rules/**/*.ts"
        ],
        "maxCyclomatic": 65535,
        "maxCognitive": 65535,
        "maxCrap": 1000000,
        "maxUnitSize": 100000,
        "reason": "Dev tooling, not shipped product: the report generators in .github/skills, the command entry points in @lcabrera/repo-standards (named one by one, never by directory glob), and the custom ESLint rule visitors are inherently procedural CLI/AST-walker code where complexity/CRAP/unit-size limits do not apply. The glob names the entry points only \u2014 the library modules beside them are ordinary code and stay governed."
      },
      {
        "files": ["scripts/**/*.{mjs,cjs}", "apps/*/scripts/**/*.{mjs,cjs}"],
        "maxCrap": 1000000,
        "reason": "Root/app build & tooling scripts are procedural CLI code the repo does not unit-test (by convention \u2014 see .claude/rules/scripts.md). CRAP = cyclomatic\u00b2 \u00d7 (1 \u2212 coverage)\u00b3 + cyclomatic, so at an untested script's estimated 0% coverage it flags ordinary branching (a cyclomatic-5 function scores CRAP 30) \u2014 the coverage-driven false signal AGENTS.md \u00a74 calls out ('crap alone means untested'). Only CRAP is relaxed here: cyclomatic, cognitive, and unit-size limits still apply, so genuinely complex script code is still caught, and per-file size is separately gated by scripts:verify."
      }
    ]
  },
  "rules": {
    "circular-dependencies": "error",
    "unused-files": "error",
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependencies": "warn",
    "prop-drilling": "error",
    "thin-wrapper": "error",
    "duplicate-prop-shape": "warn"
  },
  "overrides": [
    // Route loaders return serializable state/promises consumed by shared
    // components (TableLayout, panels) and via use() in Suspense children;
    // fallow cannot trace useLoaderData<typeof loader>() destructuring across
    // the route barrel + component-file split, so unused-load-data-keys is a
    // systematic false positive on *.loader.ts here.
    {
      "files": ["**/*.loader.ts"],
      "rules": {
        "unused-load-data-keys": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "mild",
    "ignoreImports": true
  },
  "audit": {
    "gate": "new-only",
    "deadCodeBaseline": "reports/fallow/baselines/dead-code.json",
    "healthBaseline": "reports/fallow/baselines/health.json",
    "dupesBaseline": "reports/fallow/baselines/dupes.json"
  }
}

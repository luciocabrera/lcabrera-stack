{
  // React Doctor runs as a gate here, alongside Oxlint, ESLint and Biome.
  // ADR-055 records why it is the standalone CLI rather than the documented
  // `jsPlugins` bridge into Oxlint, and why it gates at full scope.
  //
  // `.jsonc`, not `.json`, for the same reason as `biome.jsonc`: every entry
  // below needs its reason next to it. React Doctor parses JSON config as
  // JSON5, so comments are accepted in either extension — the suffix is here to
  // say "this file has comments in it" to a human, not to satisfy the parser.
  //
  // Run `vp run react-doctor:report` for the current findings; nothing is
  // committed (ADR-049).
  "$schema": "https://react.doctor/schema/config.json",

  // The gate fails on any warning as well as any error, so a finding at
  // either severity is new debt the day it lands. `repo-verify-react-doctor`
  // reads this key itself and runs the CLI with `--blocking none`, so the
  // value here is what the gate enforces (ADR-055).
  "blocking": "warning",

  // Scan everything, every run. React Doctor detects the three React
  // workspaces on its own; the Node-only workspaces have no React to analyse.
  "scope": "full",

  // Both of these reach the network, which a pre-push gate must not do: a push
  // would fail on a flaky connection, and the results would stop being
  // reproducible offline.
  //
  // `noScore` covers the score API, the share URL AND crash reporting — it is
  // the telemetry switch, despite the name. `supplyChain` posts the dependency
  // list to Socket.dev; `vp run fallow:full` and Dependabot already cover that
  // ground without sending the manifest anywhere.
  "noScore": true,
  "supplyChain": { "enabled": false },

  // Nothing here is adoptable and the search is not free: Oxlint's config lives
  // in the root `vite.config.ts` and ESLint's is a flat `.mjs`, neither of which
  // is the JSON shape this option looks for. Explicit beats an empty search
  // that silently starts finding something the day a `.oxlintrc.json` appears.
  "adoptExistingLintConfig": false,

  "rules": {
    // Promoted from warning once the repo reached zero findings (#462, after
    // #460 cleared the other half). A membership scan inside a loop is
    // quadratic whatever the constant factor, so this stays an error rather
    // than relying on `blocking` to catch it at warning.
    //
    // Verified by planting a violation and confirming the gate fails. A clean
    // run proves nothing on its own: a rule that is not loaded reports exactly
    // the same pass as compliant code.
    "react-doctor/js-set-map-lookups": "error",

    // Does not apply to this repo, so it is off at the rule level rather than
    // suppressed per site.
    //
    // The rule's own documentation names the exception: "bundlers like Vite or
    // Next.js with optimizePackageImports already tree-shake barrels well in
    // production". This is a Vite/Rolldown repo, `packages/ui` declares
    // `"sideEffects": false`, and every barrel it flags is a curated list of
    // named re-exports with no module-level code. Verified by building an entry
    // that imports one symbol from a flagged barrel: the siblings are dropped
    // and the barrel module is elided entirely (PR #457).
    //
    // Acting on it would also contradict ADR-007, which *requires* importing
    // through a curated barrel across a module boundary. The entry is explicit
    // even where the installed version ships the rule off, so a future default
    // change cannot turn it on against ADR-007 under a `warning` gate.
    "react-doctor/no-barrel-import": "off",

    // Pinned off for the same reason: the installed version ships it disabled,
    // and a future default change would let the `warning` gate block on it. Its
    // prescribed fix fuses a `.filter().map()` chain into one pass. ADR-054
    // makes the chain the default, treats fusing as a hot-path optimisation
    // applied on evidence, and measured the `flatMap` form as slower.
    "react-doctor/js-combine-iterations": "off",
  },

  "ignore": {
    "rules": [
      // Cannot be right in this monorepo. The shared ESLint config resolves its
      // plugins from the *consuming* workspace — see the `fromWorkspace(...)`
      // calls in `packages/vite-configs/eslint.custom-rules.shared.config.mjs`
      // — so each React workspace must declare `typescript-eslint`,
      // `@stylexjs/eslint-plugin` and `globals` even though nothing in its own
      // source imports them. They are load-bearing; removing one breaks the
      // ESLint pass. No static analyser can see a dynamic import by string.
      //
      // Same class of declared-but-not-statically-imported dependency as
      // ADR-047. Genuine unused dependencies are still caught by fallow.
      //
      // `ignore.rules` rather than a `rules` entry because this is a `deslop`
      // diagnostic, which the `rules` registry does not expose.
      "deslop/unused-dev-dependency",
    ],

    // Each glob is matched against the path React Doctor reports, which is
    // relative to the *project* it detected (`packages/ui`), not to the repo
    // root — a repo-relative path matches nothing and fails silently, which
    // reads identically to the override not being there.
    "overrides": [
      {
        // The populated `<tbody>` is `display: grid` and every `<tr>` is
        // `display: flex` (their own `.stylex.ts` files). A browser drops an
        // element's implicit table role along with its table `display`, so the
        // explicit `rowgroup` and `row` are the only source of the ownership
        // `role="grid"` requires (ADR-062). The rule reads JSX and cannot see
        // the stylesheet. Biome's `noRedundantRoles` is exempted on the same
        // files for the same reason in `biome.jsonc`, and both are argued in
        // `docs/agents/public-package-suppressions.json`.
        "files": [
          "src/components/Table/TableBody/TableBody.component.tsx",
          "src/components/Table/TableRow/TableRow.component.tsx",
        ],
        "rules": ["react-doctor/no-redundant-roles"],
      },
    ],
  },
}
